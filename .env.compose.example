# Copy this file to .env on the VPS and replace every placeholder.
# Keep .env out of Git and set chmod 600 .env.

POSTGRES_DB=azbuka
POSTGRES_USER=azbuka_app
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_DATABASE_PASSWORD

# The password must be URL-encoded if it contains URL-reserved characters.
DATABASE_URL=postgresql://azbuka_app:REPLACE_WITH_URL_ENCODED_PASSWORD@db:5432/azbuka

# Use the exact origin where the standalone app is hosted.
APP_ORIGINS=https://app.example.com

SESSION_TTL_DAYS=30
MAX_SYNC_EVENTS=250
TOKEN_PEPPER=REPLACE_WITH_A_SEPARATE_LONG_RANDOM_SECRET
API_PORT=8090
