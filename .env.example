# Copy to .env ON THE SERVER ONLY (chmod 600 .env). Never commit the real file.
# Generate secrets there, for example:  openssl rand -base64 36

POSTGRES_DB=azbuka
POSTGRES_USER=azbuka_app
POSTGRES_PASSWORD=<generate-on-server>

# Use the Docker service name "db" as the host. Percent-encode special characters in the password.
DATABASE_URL=postgresql://azbuka_app:<same-password>@db:5432/azbuka

# Random value, at least 16 characters, different from the database password.
TOKEN_PEPPER=<generate-on-server>

# Exact origin(s) of the web app, comma separated, no trailing slash, never "*".
APP_ORIGINS=https://your-app-domain.example

SESSION_TTL_DAYS=30
MAX_SYNC_EVENTS=250
API_PORT=8091
